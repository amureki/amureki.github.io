{
  "name": "amureki.me",
  "scripts": {
    "build": "npm run build:personal && npm run build:projects",
    "watch": "npx @tailwindcss/cli -i styles/styles.css -o static/styles.css --watch",
    "build:personal": "NODE_ENV=production npx @tailwindcss/cli -i styles/styles.css -o static/styles.css -m",
    "build:projects": "NODE_ENV=production npx @tailwindcss/cli -i styles/project-pages.css -o static/project-pages.css -m"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^4.3.3"
  }
}
